<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Send to GRBL Sender</name>
  <id>org.grblcontrollersender.send_to_grbl_sender</id>
  <effect>
    <effects-menu>
      <submenu name="GRBL Sender"/>
    </effects-menu>
  </effect>
  <script>
    <command location="inx" interpreter="python">grbl_sender_bridge.py</command>
  </script>
</inkscape-extension>
