# Build artifacts (typhonbuild64 -B --ws=qt5) - rebuildable from source,
# not needed in the repo, and would bloat it (the .dbg alone is ~44MB).
lib/
backup/
*.o
*.ppu
*.compiled
*.or
*.res
*.dbg
GRBL-Controller-Sender
*.exe
__pycache__/

# Personal editor/IDE config - not shared project config, machine-specific.
.vscode/

# reference-only clones of forked upstream projects, not part of this project's own repo
References/

# third-party build tooling binaries, not part of this project's own repo -
# tools/* (not tools/) so the exceptions below (this project's OWN bridge
# plugin source, Phases 27-30) can still be tracked
tools/*
!tools/inkscape-extension/
!tools/gimp-plugin/
!tools/krita-plugin/
!tools/qcad-plugin/
!tools/freecad-macro/
!tools/kicad-plugin/
