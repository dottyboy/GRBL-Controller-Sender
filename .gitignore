# Build artifacts (typhonbuild64 -B --ws=qt5) - rebuildable from source,
# not needed in the repo, and would bloat it (the .dbg alone is ~44MB).
lib/
backup/
*.o
*.ppu
*.compiled
*.or
*.res
*.dbg
GRBL-Controller-Sender
*.exe
__pycache__/

# Personal editor/IDE config - not shared project config, machine-specific.
.vscode/
*.ctps

# reference-only clones of forked upstream projects, not part of this project's own repo
references/

# Phase 23's runtime-only ONNX assets (libonnxruntime.so, the depth model) -
# a manual local copy for a dev build, same convention as references/ above;
# see packaging/appimage/build-appimage.sh for how the AppImage gets its own.
onnx-models/

# third-party build tooling binaries, not part of this project's own repo -
# tools/* (not tools/) so the exceptions below (this project's OWN bridge
# plugin source, Phases 27-30) can still be tracked
tools/*
!tools/inkscape-extension/
!tools/gimp-plugin/
!tools/krita-plugin/
!tools/qcad-plugin/
!tools/freecad-macro/
!tools/kicad-plugin/
!tools/onnxruntime/
tools/onnxruntime/cache/

# Internal status summary - for us, not for the repo
STATUS.md

# AppImage build output - rebuildable via packaging/appimage/build-appimage.sh,
# too large/machine-specific for the repo (bundles host Qt5/X11 libs)
*.AppImage
packaging/appimage/AppDir/
